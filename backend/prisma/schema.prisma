// Prisma schema for the template enterprise backend.
// Kept models: User, AuditLog, SystemSetting, RegistrationToken.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
  engineType   = "library"
}

// Connection URL lives in prisma.config.ts (Prisma 7+ requirement).
datasource db {
  provider   = "postgresql"
  extensions = [vector, pg_trgm]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  USER
}

enum AuditActor {
  SYSTEM
  USER
  ADMIN
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  passwordHash  String?
  name      String?
  role      UserRole   @default(USER)
  // Backward-compat: the user's single "primary" model id.
  defaultLlmModelId String?
  // Model ENTITLEMENT copied from the redeemed registration token.
  grantedModelIds String[] @default([])
  // Chat-quota RESET EPOCH.
  quotaResetAt DateTime?
  auditLogs AuditLog[] @relation("AuditActor")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tokensCreated  RegistrationToken[] @relation("CreatedTokens")
  tokensConsumed RegistrationToken[] @relation("ConsumedTokens")
  passwordResetTokens PasswordResetToken[]

  // Story: shared-channel (back-relations only; no columns added to "User").
  customerProfile   Customer?
  channelsCreated   SharedChannel[] @relation("ChannelCreator")
  channelMemberships ChannelMember[]
  messages          Message[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Story: shared-channel — customers, shared channels, members and messages
// ─────────────────────────────────────────────────────────────────────────────

enum ChannelMemberRole {
  VENDOR
  CUSTOMER
}

model Customer {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  createdAt   DateTime @default(now())
}

model SharedChannel {
  id          String          @id @default(cuid())
  name        String
  createdById String
  createdBy   User            @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  members     ChannelMember[]
  messages    Message[]

  @@index([createdById])
}

model ChannelMember {
  id        String            @id @default(cuid())
  channelId String
  channel   SharedChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChannelMemberRole
  createdAt DateTime          @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id        String        @id @default(cuid())
  channelId String
  channel   SharedChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())

  @@index([channelId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit log
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id           String     @id @default(cuid())
  firmId       String?
  actor        AuditActor
  actorUserId  String?
  actorUser    User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  payloadJson  Json
  createdAt    DateTime   @default(now())

  @@index([actorUserId])
  @@index([createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// System settings (runtime override of service credentials)
// ─────────────────────────────────────────────────────────────────────────────

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Registration tokens (one-time admin-issued invite codes for signup)
// ─────────────────────────────────────────────────────────────────────────────

model RegistrationToken {
  token        String    @id
  createdAt    DateTime  @default(now())
  createdById  String?
  createdBy    User?     @relation("CreatedTokens",  fields: [createdById],  references: [id], onDelete: SetNull)
  consumed     Boolean   @default(false)
  consumedAt   DateTime?
  consumedById String?
  consumedBy   User?     @relation("ConsumedTokens", fields: [consumedById], references: [id], onDelete: SetNull)
  firmId       String?
  role         String?
  expiresAt    DateTime?
  grantedModelIds String[] @default([])

  @@index([consumed])
}

// ─────────────────────────────────────────────────────────────────────────────
// Password reset tokens (single-use, short-lived, per OWASP guidance)
// ─────────────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumed   Boolean   @default(false)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Colossus managed accounts (seeded from COLOSSUS_ACCOUNTS_JSON)
// ─────────────────────────────────────────────────────────────────────────────

model ColossusAccount {
  id           String   @id @default(cuid())
  role         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  loginPath    String?  @map("login_path")
  createdBy    String   @default("colossus") @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("colossus_accounts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Vendor onboarding (Story: vendor-onboarding)
// userId is a plain FK column (no Prisma relation) so the auth User model stays untouched.
// ─────────────────────────────────────────────────────────────────────────────

enum VendorDocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model VendorProfile {
  id           String           @id @default(cuid())
  userId       String           @unique
  companyName  String
  contactName  String
  contactEmail String
  contactPhone String?
  address      String?
  completed    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  documents    VendorDocument[]
}

model VendorDocument {
  id        String               @id @default(cuid())
  vendorId  String
  vendor    VendorProfile        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  fileKey   String
  name      String
  type      String
  status    VendorDocumentStatus @default(PENDING_REVIEW)
  createdAt DateTime             @default(now())

  @@index([vendorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Story: order-management — vendor catalog, purchase orders, customer notices.
// vendorUserId / customerUserId are plain FK columns (no Prisma relation) so the
// auth User model and the shared-channel tables stay untouched.
// ─────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
}

model Product {
  id             String      @id @default(cuid())
  vendorUserId   String
  name           String
  description    String?
  unitPriceCents Int         @default(0)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]

  @@index([vendorUserId])
}

model Order {
  id                    String              @id @default(cuid())
  customerUserId        String
  vendorUserId          String
  status                OrderStatus         @default(PENDING)
  estimatedDeliveryDate DateTime?
  confirmedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  items                 OrderItem[]
  notifications         OrderNotification[]

  @@index([vendorUserId, status])
  @@index([customerUserId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int
  unitPriceCents Int

  @@index([orderId])
}

model OrderNotification {
  id        String    @id @default(cuid())
  userId    String
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Story: customer-invite — single-use, expiring customer invitations.
// invitedById / acceptedUserId are plain FK columns (no Prisma relation) so the
// auth User model stays untouched.
// ─────────────────────────────────────────────────────────────────────────────

model CustomerInvitation {
  id             String    @id @default(cuid())
  email          String
  companyName    String?
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  invitedById    String
  createdAt      DateTime  @default(now())

  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// Story: invoice-generation — one invoice per CONFIRMED order.
// orderId / vendorUserId / customerUserId are plain FK columns (no Prisma
// relation) so the order-management and auth tables stay untouched.
// ─────────────────────────────────────────────────────────────────────────────

model Invoice {
  id             String   @id @default(cuid())
  orderId        String   @unique
  vendorUserId   String
  customerUserId String
  number         String   @unique
  totalCents     Int
  createdAt      DateTime @default(now())

  @@index([vendorUserId])
  @@index([customerUserId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Story: notification-preferences — effective-dated per-user alert toggles.
// Each save appends a row; the row in effect at an event's time decides whether
// that event shows in the user's alerts feed, so earlier alerts never change.
// userId is a plain FK column (no Prisma relation) so the auth User model stays untouched.
// ─────────────────────────────────────────────────────────────────────────────

model NotificationPreferenceChange {
  id            String   @id @default(cuid())
  userId        String
  orderAlerts   Boolean  @default(true)
  messageAlerts Boolean  @default(true)
  effectiveAt   DateTime @default(now())

  @@index([userId, effectiveAt])
}
